# =============================================================================
# NG-SOAR :: KMS + CACAO Validator/Executor compose project (rendered by ng_soar role)
# /etc/ng-soar/operator.token gates the NG-SOAR Operator endpoints (UML 10-11).
# =============================================================================
services:
  cacao-validator-executor:
    build: ./cacao
    image: ng-soar/cacao-validator-executor:training
    container_name: cacao-validator-executor
    restart: unless-stopped
    ports:
      - "9100:9100"
    environment:
      ENFORCE_HOST: "{{ target_service_ip }}"
      ENFORCE_USER: "{{ mgmt_user }}"
      ATTACKER_HOST: "{{ malicious_source_ip }}"
      ATTACKER_USER: "{{ mgmt_user }}"
      TARGET_HOST: "{{ target_service_ip }}"
      TARGET_PORT: "{{ target_service_http_port }}"
      SSH_KEY: "/keys/id_ed25519"
      OPERATOR_TOKEN_FILE: "/secrets/operator.token"
    volumes:
      - /opt/ng-soar-cacao/keys:/keys:ro
      - /etc/ng-soar:/secrets:ro
      - /var/log/ng-soar:/var/log/ng-soar
    networks:
      - ngsoar

networks:
  ngsoar:
    driver: bridge
